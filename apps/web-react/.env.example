# Firebase Web app config (project: vetplus-digital)
# Create a Web app in the Firebase console to obtain these values, then copy
# this file to `.env.local` and fill them in. All must be prefixed with VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=vetplus-digital
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push (FCM) VAPID public key — Firebase console > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=
