{
  "name": "vetplus-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/web-react",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web-react",
    "build": "npm run build --workspace apps/web-react",
    "preview": "npm run preview --workspace apps/web-react",
    "test": "npm run test --workspaces --if-present"
  }
}
